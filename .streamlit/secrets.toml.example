# Copy to .streamlit/secrets.toml (git-ignored) and fill in your own values.

# Supabase -> Project Settings -> API. Use the *anon / publishable* key, NEVER the service_role key.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "YOUR-ANON-PUBLIC-KEY"

# platform.deepseek.com -> API keys
DEEPSEEK_API_KEY = "YOUR-DEEPSEEK-API-KEY"

# --- optional ---
# DEEPSEEK_MODEL = "deepseek-flash"     # must be a vision model - deepseek-v4-pro has no image input
# DEEPSEEK_BASE_URL = "https://YOUR-WORKER.workers.dev/deepseek"   # reverse proxy, see docs/cloudflare-worker.js
# MAX_GRADINGS_PER_DAY = 20             # per student, protects your API budget
